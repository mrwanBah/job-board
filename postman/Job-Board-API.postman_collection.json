      "name": "Authentication",
      "item": [
        {
          "name": "Register applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{applicantEmail}}\",\n  \"password\": \"DemoPass123!\",\n  \"fullName\": \"Collection applicant\",\n  \"role\": \"APPLICANT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('applicantEmail', 'collection-applicant-' + suffix + '@example.com');",
                  "pm.collectionVariables.set('companyEmail', 'collection-company-' + suffix + '@example.com');",
                  "pm.collectionVariables.set('expiresAt', new Date(Date.now() + 30 * 86400000).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
