              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Applicant sees ACCEPTED', () => pm.expect(pm.response.json().find(a => String(a.id) === String(pm.collectionVariables.get('applicationId'))).status).to.eql('ACCEPTED'));"
                ]
              }
            }
