{
  "info": {
    "_postman_id": "3af2d3fd-f972-4a44-a8df-c69ff1bf099b",
    "name": "Job Board API",
    "description": "Week 4 backend verification collection. Run requests in folder order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "companyToken", "value": "" },
    { "key": "applicantToken", "value": "" },
    { "key": "jobId", "value": "1" },
    { "key": "applicationId", "value": "1" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register applicant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"applicant@example.com\",\"password\":\"password123\",\"fullName\":\"Demo Applicant\",\"role\":\"APPLICANT\"}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login applicant",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set('applicantToken', pm.response.json().token);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"applicant@example.com\",\"password\":\"password123\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login company",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set('companyToken', pm.response.json().token);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"company@example.com\",\"password\":\"password123\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get current applicant",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{applicantToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/jobs?search=&page=0&size=10"
          }
        },
        {
          "name": "Get job",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/jobs/{{jobId}}"
          }
        },
        {
          "name": "Create job",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "pm.collectionVariables.set('jobId', pm.response.json().id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{companyToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Java Backend Developer\",\"description\":\"Build and maintain REST APIs.\",\"location\":\"Riyadh\",\"jobType\":\"FULL_TIME\",\"salaryMin\":7000,\"salaryMax\":10000,\"expiresAt\":\"2026-12-31\"}"
            },
            "url": "{{baseUrl}}/api/jobs"
          }
        },
        {
          "name": "Get my company jobs",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{companyToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/jobs/my?page=0&size=10"
          }
        },
        {
          "name": "Update job",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{companyToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Senior Java Backend Developer\",\"description\":\"Build secure REST APIs.\",\"location\":\"Riyadh\",\"jobType\":\"FULL_TIME\",\"salaryMin\":9000,\"salaryMax\":13000,\"expiresAt\":\"2026-12-31\"}"
            },
            "url": "{{baseUrl}}/api/jobs/{{jobId}}"
          }
        },
        {
          "name": "Deactivate job",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{companyToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/jobs/{{jobId}}"
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "Get company",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/companies/1"
          }
        },
        {
          "name": "Update my company",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{companyToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Acme Tech\",\"description\":\"Backend engineering company.\",\"website\":\"https://example.com\",\"logoUrl\":null,\"location\":\"Riyadh\"}"
            },
            "url": "{{baseUrl}}/api/companies/me"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Apply to job",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "pm.collectionVariables.set('applicationId', pm.response.json().id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{applicantToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"coverLetter\":\"I am interested in this role.\"}" },
            "url": "{{baseUrl}}/api/jobs/{{jobId}}/apply"
          }
        },
        {
          "name": "Get my applications",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{applicantToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/applications/mine"
          }
        },
        {
          "name": "Get job applicants",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{companyToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/jobs/{{jobId}}/applications"
          }
        },
        {
          "name": "Update application status",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{companyToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"status\":\"REVIEWED\"}" },
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/status"
          }
        }
      ]
    }
  ]
}
