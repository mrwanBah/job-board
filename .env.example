POSTGRES_DB=jobboard
POSTGRES_USER=jobboard_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5433
BACKEND_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/jobboard
SPRING_DATASOURCE_USERNAME=jobboard_user
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-database-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=86400000

# Frontend (build-time; used by the docker compose frontend build arg)
VITE_API_URL=http://localhost:8080
